# strata config: copy to ~/.config/strata/stratarc (or $XDG_CONFIG_HOME/strata/stratarc)
# Mirrors the zathura look: translucent catppuccin background, white ink, transparent paper.

set default-bg           "#1e1e2e99"
set recolor              true
set recolor-lightcolor   "#1e1e2e"
set recolor-darkcolor    "#ffffff"
set recolor-keephue      false

set cache-mb             64
set cache-max-mb         2048     # on-disk analysis/OCR cache cap (LRU)
set previews             true     # hover and keyboard previews of equations, theorems, figures
set preview-hover-ms     300
set preview-max-scale    3
set scroll-step          40
set zoom-step            10
set page-gap             8
set statusbar            true
set font                 "monospace"
set font-size            13
set incremental-search   true

# Background analysis (runs in a separate niced process, results cached in ~/.cache/strata)
set auto-analyze         true
set auto-ocr             true     # OCR scanned documents with ocrmypdf
set auto-index           auto     # auto: only when the file has no outline | always | off

# State (position, bookmarks, marks) lives in ~/.local/share/strata/strata.db
set restore-position     true     # reopen at the last page, zoom and recolor state

# SyncTeX (vimtex): Ctrl+click on the page runs synctex edit, then this command.
# %{input} %{line} %{column} are substituted; the value is split like a shell line, no shell is involved.
set synctex              true
# set synctex-editor-command "nvim --server /tmp/vimtexserver.pipe --remote-expr \"vimtex#view#inverse_search(%{line}, '%{input}')\""

# map [mode] KEYS COMMAND     (modes: normal, index)
map <C-x> goto 1
# unmap <Space>
# include ~/.config/strata/extra.rc
