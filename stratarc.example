# strata config: copy to ~/.config/strata/stratarc (or $XDG_CONFIG_HOME/strata/stratarc)
# Mirrors the zathura look: translucent catppuccin background, white ink, transparent paper.

set default-bg           "#1e1e2e99"
set recolor              true
set recolor-lightcolor   "#1e1e2e"
set recolor-darkcolor    "#ffffff"
set recolor-keephue      false

set cache-mb             64
set cache-max-mb         2048     # on-disk analysis/OCR cache cap (LRU)
set previews             true     # hover and keyboard previews of equations, theorems, figures
set preview-hover-ms     300
set preview-max-scale    3
set scroll-step          40
set zoom-step            10
set wheel-step           50       # logical px per mouse-wheel notch
set touchpad-scroll-factor 1.0    # multiplier for touchpad scrolling
set wheel-zoom-step      0        # Ctrl+wheel zoom % per notch (0 = zoom-step)
set page-gap             8
set statusbar            true
set font                 "monospace"
set font-size            13
set incremental-search   true

# Background analysis (runs in a separate niced process, results cached in ~/.cache/strata)
set auto-analyze         true
set auto-ocr             true     # OCR scanned documents with ocrmypdf
set auto-index           auto     # auto: only when the file has no outline | always | off

# Images: keep original colours (photos stay readable); scans (page-sized images) are always recolored
set recolor-images       keep     # keep | dim | recolor
set recolor-image-dim    0.85
set recolor-invert-dark-images false  # recolor dark page-sized images (covers) with an inverted mapping
set goto-printed         true     # :goto 120 means printed page 120 when the book has page numbers

# Look profiles: Ctrl-t cycles, :profile NAME applies. Without any `profile` line, `normal` and `textbook` exist.
# profile textbook recolor-lightcolor rgba(0,0,0,0)
# profile textbook recolor-darkcolor  rgba(255,255,255,1)
# profile textbook default-bg         rgba(0,0,0,0)
# profile textbook recolor-keephue    false

# Float window (gf, :float, strata --float FILE [--page N])
set float-width          520
set float-height         700
set float-position       top-right

# State (position, bookmarks, marks) lives in ~/.local/share/strata/strata.db
set restore-position     true     # reopen at the last page, zoom and recolor state

# SyncTeX (vimtex): Ctrl+click on the page runs synctex edit, then this command.
# %{input} %{line} %{column} are substituted; the value is split like a shell line, no shell is involved.
set synctex              true
# set synctex-editor-command "nvim --server /tmp/vimtexserver.pipe --remote-expr \"vimtex#view#inverse_search(%{line}, '%{input}')\""

# Auto-reload: reload when the file is rewritten on disk (LaTeX builds), keeping page, offset and zoom.
# An inotify watch on the directory, read by a thread that blocks; off means no thread and no fd.
set auto-reload          true

# Book mode (d, :book): two-page spreads; J/K move by spread, fit-width/fit-page fit the spread.
set first-page-single    true     # the first page (cover) stands alone
set book-rtl             false    # right-to-left spreads (manga, Arabic, Hebrew)

# Presentation (F5, :present): fullscreen, one page at fit-page, no statusbar; j k Space BackSpace arrows and
# left-click change the page by exactly one, Esc q F5 return to the previous page, offset and zoom.
set presentation-bg      #000000  # rgba(0,0,0,0) lets the desktop show through

# map [mode] KEYS COMMAND     (modes: normal, index)
map <C-x> goto 1
# unmap <Space>
# include ~/.config/strata/extra.rc
