[Desktop Entry]
Type=Application
Name=Strata
GenericName=Document Viewer
Comment=Keyboard-driven PDF and EPUB reader
Exec=strata %f
Icon=application-pdf
Terminal=false
Categories=Office;Viewer;Education;
MimeType=application/pdf;application/epub+zip;application/oxps;application/vnd.comicbook+zip;
StartupWMClass=strata
Keywords=pdf;epub;reader;document;
